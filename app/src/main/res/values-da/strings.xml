    <string name="about_description">Professionel applikation til programmering af PIC-mikrocontrollere ved hjælp af KITSRUS &lt;b&gt;Protocol P018&lt;/b&gt;. Det giver dig mulighed for at programmere PIC-enheder direkte fra Android via USB OTG uden behov for en pc.</string>
    <string name="about_features">Hovedtræk:</string>
    <string name="about_feature_1">Mobil programmering uden PC via OTG.</string>
    <string name="about_feature_2">Understøttelse af KITSRUS P018-protokoller (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Intuitivt materialedesign-interface.</string>
    <string name="about_feature_4">Understøttelse af arm64-v8a, armeabi-v7a, x86 og x86_64 arkitekturer.</string>
    <string name="about_acknowledgements_title">Anerkendelser:</string>
    <string name="about_acknowledgements_desc">Særlig tak til Mike Wakerly, Adam Schubert og AndroidIDE, Android Code Studio og KITSRUS-holdene.</string>
