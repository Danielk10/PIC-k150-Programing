    <string name="about_description">Profesionalna aplikacija za programiranje PIC mikrokontrolera pomoću KITSRUS <b>Protocol P018</b>. Omogućuje vam programiranje PIC uređaja izravno s Androida putem USB OTG-a bez potrebe za računalom.</string>
    <string name="about_features">Glavne karakteristike:</string>
    <string name="about_feature_1">Mobilno programiranje bez PC-a preko OTG-a.</string>
    <string name="about_feature_2">Podrška za KITSRUS P018 protokole (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Intuitivno sučelje Material Design.</string>
    <string name="about_feature_4">Podrška za arm64-v8a, armeabi-v7a, x86 i x86_64 arhitekture.</string>
    <string name="about_acknowledgements_title">Zahvale:</string>
    <string name="about_acknowledgements_desc">Posebna zahvala Mikeu Wakerlyju, Adamu Schubertu i timovima AndroidIDE, Android Code Studio i KITSRUS.</string>
