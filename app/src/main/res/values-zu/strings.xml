    <string name="about_description">Uhlelo lokusebenza oluchwepheshile lokuhlela ama-microcontroller e-PIC kusetshenziswa i-KITSRUS <b>Protocol P018</b>. Ikuvumela ukuthi uhlele amadivayisi we-PIC ngqo kusuka ku-Android nge-USB OTG ngaphandle kwesidingo se-PC.</string>
    <string name="about_features">Izici eziyinhloko:</string>
    <string name="about_feature_1">Izinhlelo zeselula ngaphandle kwe-PC nge-OTG.</string>
    <string name="about_feature_2">Ukusekelwa kwezivumelwano ze-KITSRUS P018 (K150, K128, K149, K182).</string>
    <string name="about_feature_3">I-interface ye-Intuitive Material Design.</string>
    <string name="about_feature_4">Usekelo lwezakhiwo ze-armeabi-v7a, i-armeabi-v7a kanye ne-x86_64 ye-armeabi-v8a.</string>
    <string name="about_acknowledgements_title">Ukubonga:</string>
    <string name="about_acknowledgements_desc">Sibonga ngokukhethekile ku-Mike Wakerly, u-Adam Schubert, kanye ne-AndroidIDE, i-Android Code Studio, namaqembu e-KITSRUS.</string>
