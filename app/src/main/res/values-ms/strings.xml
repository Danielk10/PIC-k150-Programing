    <string name="about_description">Aplikasi profesional untuk memprogramkan mikropengawal PIC menggunakan KITSRUS <b>Protocol P018</b>. Ia membolehkan anda memprogram peranti PIC terus dari Android melalui USB OTG tanpa memerlukan PC.</string>
    <string name="about_features">Ciri-ciri utama:</string>
    <string name="about_feature_1">Pengaturcaraan mudah alih tanpa PC melalui OTG.</string>
    <string name="about_feature_2">Sokongan untuk protokol KITSRUS P018 (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Antara muka Reka Bentuk Bahan Intuitif.</string>
    <string name="about_feature_4">Sokongan untuk seni bina arm64-v8a, armeabi-v7a, x86 dan x86_64.</string>
    <string name="about_acknowledgements_title">Penghargaan:</string>
    <string name="about_acknowledgements_desc">Terima kasih istimewa kepada Mike Wakerly, Adam Schubert dan pasukan AndroidIDE, Android Code Studio dan KITSRUS.</string>
