    <string name="about_description">Profesjonell applikasjon for å programmere PIC-mikrokontrollere ved å bruke KITSRUS <b>Protocol P018</b>. Den lar deg programmere PIC-enheter direkte fra Android via USB OTG uten behov for en PC.</string>
    <string name="about_features">Hovedtrekk:</string>
    <string name="about_feature_1">Mobil programmering uten PC via OTG.</string>
    <string name="about_feature_2">Støtte for KITSRUS P018-protokoller (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Intuitivt grensesnitt for materialdesign.</string>
    <string name="about_feature_4">Støtte for arm64-v8a, armeabi-v7a, x86 og x86_64 arkitekturer.</string>
    <string name="about_acknowledgements_title">Anerkjennelser:</string>
    <string name="about_acknowledgements_desc">Spesiell takk til Mike Wakerly, Adam Schubert og teamene AndroidIDE, Android Code Studio og KITSRUS.</string>
