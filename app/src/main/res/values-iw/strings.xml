    <string name="about_description">יישום מקצועי לתכנות מיקרו-בקרי PIC באמצעות KITSRUS <b>Protocol P018</b>. זה מאפשר לך לתכנת התקני PIC ישירות מאנדרואיד באמצעות USB OTG ללא צורך במחשב.</string>
    <string name="about_features">מאפיינים עיקריים:</string>
    <string name="about_feature_1">תכנות נייד ללא PC דרך OTG.</string>
    <string name="about_feature_2">תמיכה בפרוטוקולי KITSRUS P018 (K150, K128, K149, K182).</string>
    <string name="about_feature_3">ממשק עיצוב חומרים אינטואיטיבי.</string>
