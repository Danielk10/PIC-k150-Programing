    <string name="about_description">Professional application to program PIC microcontrollers using the KITSRUS &lt;b&gt;Protocol P018&lt;/b&gt;. It allows you to program PIC devices directly from Android via USB OTG without the need for a PC.</string>
    <string name="about_features">Main features:</string>
    <string name="about_feature_1">Mobile programming without PC via OTG.</string>
    <string name="about_feature_2">Support for KITSRUS P018 protocols: K150, K128, K149, K182.</string>
    <string name="about_feature_3">Intuitive Material Design interface.</string>
    <string name="about_feature_4">Support for arm64-v8a, armeabi-v7a, x86 and x86_64 architectures.</string>
    <string name="about_acknowledgements_title">Acknowledgments:</string>
    <string name="about_acknowledgements_desc">Special thanks to Mike Wakerly, Adam Schubert, and the AndroidIDE, Android Code Studio, and KITSRUS teams.</string>
