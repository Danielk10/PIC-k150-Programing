    <string name="about_description">Profesionálna aplikácia na programovanie mikrokontrolérov PIC pomocou KITSRUS <b>Protocol P018</b>. Umožňuje vám programovať zariadenia PIC priamo z Androidu cez USB OTG bez potreby PC.</string>
    <string name="about_features">Hlavné vlastnosti:</string>
    <string name="about_feature_1">Mobilné programovanie bez PC cez OTG.</string>
    <string name="about_feature_2">Podpora protokolov KITSRUS P018 (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Intuitívne rozhranie Material Design.</string>
    <string name="about_feature_4">Podpora pre architektúry arm64-v8a, armeabi-v7a, x86 a x86_64.</string>
    <string name="about_acknowledgements_title">Poďakovanie:</string>
    <string name="about_acknowledgements_desc">Špeciálne poďakovanie patrí Mikeovi Wakerlymu, Adamovi Schubertovi a tímom AndroidIDE, Android Code Studio a KITSRUS.</string>
