    <string name="about_description">Ứng dụng chuyên nghiệp để lập trình bộ vi điều khiển PIC bằng KITSRUS <b>Protocol P018</b>. Nó cho phép bạn lập trình các thiết bị PIC trực tiếp từ Android thông qua USBOTG mà không cần PC.</string>
    <string name="about_features">Các tính năng chính:</string>
    <string name="about_feature_1">Lập trình di động không cần PC thông qua cổng OOT.</string>
    <string name="about_feature_2">Hỗ trợ các giao thức KITSRUS P018 (K150, K128, K149, K182).</string>
    <string name="about_feature_3">Giao diện Thiết kế Vật liệu trực quan.</string>
    <string name="about_feature_4">Hỗ trợ kiến ​​trúc arm64-v8a, armeabi-v7a, x86 và x86_64.</string>
    <string name="about_acknowledgements_title">Lời cảm ơn:</string>
    <string name="about_acknowledgements_desc">Đặc biệt xin cảm ơn Mike Wakerly, Adam Schubert và các nhóm AndroidIDE, Android Code Studio và KITSRUS.</string>
