<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    tools:context=".MainActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#003366"
            android:elevation="8dp"
            app:titleTextColor="#FFFFFF"
            app:title="@string/app_name">

            <View
                android:id="@+id/connectionIndicator"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:background="@drawable/connection_indicator" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Layout principal compacto (SIN ScrollView externo) -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout"
        app:layout_constraintBottom_toTopOf="@+id/bannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1: Selector de Chip + Imagen Socket (Movido arriba) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#2A2A3E"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:baselineAligned="false"
                android:gravity="center_vertical">

                <!-- Columna izq: Label + Spinner + ChipInfo -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/seleccionar_chip_pic"
                        android:textColor="#FF6600"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/chipSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginBottom="4dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:spinnerMode="dropdown" />

                    <TextView
                        android:id="@+id/chipInfoTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:padding="4dp"
                        android:text="@string/esperando_seleccion"
                        android:textColor="#4CAF50"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Imagen del Socket -->
                <ImageView
                    android:id="@+id/chipSocketImageView"
                    android:layout_width="100dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="Socket Diagram"
                    android:scaleType="fitCenter"
                    android:visibility="visible" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Fila 2: Fuse Status + ICSP (Rediseñado) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical">

            <!-- Estado de Fuses -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:layout_marginEnd="4dp"
                app:cardBackgroundColor="#2A2A3E"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estado_fusibles"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/fuseStatusTextView"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/fuses_no_configurados"
                        android:textColor="#757575"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:background="#3A3A3A"
                        android:ellipsize="end"
                        android:singleLine="true" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Modo ICSP -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:layout_marginStart="4dp"
                app:cardBackgroundColor="#2A2A3E"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modo_icsp"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swModeICSP"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="#FFFFFF"
                        android:trackTint="#90EE90" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Fila 3: Botones de operación (compactos en grid) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            app:cardBackgroundColor="#2A2A3E"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/operaciones"
                    android:textColor="#FF6600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Fila A: Cargar archivo -->
                <Button
                    android:id="@+id/btnSelectHex"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#4CAF50"
                    android:text="@string/cargar_archivo_hex"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <!-- Fila B: Config Fuses + Blank Check -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConfigureFuses"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/configurar_fusibles"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />

                    <Button
                        android:id="@+id/btnBlankCheck"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/verificar_borrado"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />
                </LinearLayout>

                <!-- Fila C: Programar -->
                <Button
                    android:id="@+id/btnProgramarPic"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginBottom="4dp"
                    android:backgroundTint="#555555"
                    android:enabled="false"
                    android:text="@string/programar_pic"
                    android:textColor="#AAAAAA"
                    android:textSize="12sp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />

                <!-- Fila D: Leer + Verificar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLeerMemoriaDeLPic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/leer_memoria"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />

                    <Button
                        android:id="@+id/btnVerificarMemoriaDelPic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/verificar"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />
                </LinearLayout>

                <!-- Fila E: Borrar + Detectar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnBorrarMemoriaDeLPic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/borrar_memoria"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />

                    <Button
                        android:id="@+id/btnDetectarPic"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:backgroundTint="#555555"
                        android:enabled="false"
                        android:text="@string/detectar_pic"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Fila 4: LOG con scroll propio (ocupa el espacio restante) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#101018"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <!-- FrameLayout para superponer el botón limpiar sobre el scroll -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- ScrollView del log -->
                <ScrollView
                    android:id="@+id/logScrollView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="vertical">

                    <TextView
                        android:id="@+id/processStatusTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="start|top"
                        android:padding="10dp"
                        android:paddingBottom="48dp"
                        android:text="@string/esperando_operacion"
                        android:textColor="#00FFCC"
                        android:textSize="11sp" />
                </ScrollView>

                <!-- Botón limpiar log (esquina inferior derecha) -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnLimpiarLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:contentDescription="Limpiar log"
                    app:srcCompat="@android:drawable/ic_menu_delete"
                    app:backgroundTint="#CC333355"
                    app:fabSize="mini"
                    app:tint="#FF6666" />

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contenedores ocultos para compatibilidad -->
        <LinearLayout
            android:id="@+id/romDataContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/eepromDataContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Banner de publicidad ABAJO -->
    <FrameLayout
        android:id="@+id/bannerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
